# Reqlore Docker configuration.
#
# Copy this file to `.env` (same folder as docker-compose.yml) and set a
# strong password. Docker Compose loads `.env` automatically, so a plain
# `docker compose up -d` will then start Reqlore with the login gate active --
# no separate set-password command needed.
#
#   cp .env.example .env
#   # edit .env, set REQLORE_PASSWORD
#   docker compose up -d --build
#
# On first start the password is hashed (argon2id) and stored in
# ./data/.reqlore-auth. The plaintext is never written to disk. After that you
# may delete `.env` if you like -- the stored hash is reused on every launch.
#
# To change the password later: update this value AND delete
# ./data/.reqlore-auth, or run `docker compose run --rm reqlore set-password`.

REQLORE_PASSWORD=change-me-to-a-strong-password
