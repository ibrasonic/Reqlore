# Keep the docker context small + reproducible.
.git
.gitignore
.gitattributes
.github/
.idea/
.vscode/
.venv/
.env
.envrc
.mypy_cache/
.ruff_cache/
.pytest_cache/
__pycache__/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/*.egg-info/
build/
dist/
*.whl
*.tar.gz

# Project files / runtime artifacts that must never end up in an image
*.rlr
*.rlr-shm
*.rlr-wal
_ui.out
_ui.err
_pytest.log
_b.log

# Docs / test data the runtime doesn't need
docs/
examples/
scripts/
reqlore/tests/
reqlore/tests/**

# Editor / OS junk
.DS_Store
Thumbs.db
